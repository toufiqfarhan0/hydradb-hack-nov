# Google Gemini API key — only needed for the live autonomous agent execution arm
# (`python lucen.py gemini-agent` or clicking 'Run Gemini Agent (Live)' in the web console).
# Every deterministic result (GraphBLAS traversal, token pruning, edge reweighting,
# 100-thread concurrency tests, and benchmark verification) runs 100% locally without it.
GEMINI_API_KEY=

# Optional: Gemini model identifier (defaults to cutting-edge gemini-flash-lite-latest / gemini-3.5-flash-lite)
GEMINI_MODEL=models/gemini-flash-lite-latest

# Optional: HydraDB HTTP endpoint override. Defaults match external HydraDB server.
# If HydraDB is not running, Lucen automatically falls back to its embedded GraphBLAS CSR kernel.
HYDRA_HTTP=http://127.0.0.1:8443
HYDRA_METRICS=http://127.0.0.1:9090/metrics
HYDRA_TOKEN=local-development-token-32-bytes

# Optional: FastAPI service port and frontend API endpoint.
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
